generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  tagline     String
  description String
  price       Int               // IDR, no decimals
  compareAt   Int?              // original price for strike-through
  category    String            // bug | premium | ai | other
  badge       String?           // NEW / HOT / BEST
  features    String            // JSON array as text
  stock       Int      @default(999)
  active      Boolean  @default(true)
  featured    Boolean  @default(false)
  createdAt   DateTime @default(now())
  orders      Order[]
}

model Order {
  id         String   @id @default(cuid())
  ref        String   @unique
  productId  String
  product    Product  @relation(fields: [productId], references: [id])
  buyerName  String
  contact    String            // wa number / email
  note       String?
  qty        Int      @default(1)
  total      Int
  status     String   @default("pending") // pending | paid | delivered | cancelled
  createdAt  DateTime @default(now())
}

model Message {
  id        String   @id @default(cuid())
  name      String
  contact   String
  body      String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}
